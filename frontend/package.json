{
  "name": "frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint . --max-warnings 0",
    "test": "ng test --watch=false --browsers=ChromiumHeadless",
    "test:coverage": "ng test --watch=false --browsers=ChromiumHeadless --coverage",
    "test:watch": "ng test",
    "e2e": "playwright test",
    "e2e:references": "node ../scripts/e2e-references.mjs",
    "check:composants": "node ../scripts/check-composants-partages.mjs ..",
    "check:espacement": "node ../scripts/check-espacement.mjs ..",
    "check:logique": "node ../scripts/check-proprietes-logiques.mjs ..",
    "check:contraste": "node ../scripts/check-contraste-jetons.mjs ..",
    "audit:deps": "npm audit --audit-level=moderate",
    "audit:licences": "license-checker-rseidelsohn --production --summary --excludePrivatePackages --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;OFL-1.1;BlueOak-1.0.0;CC0-1.0;Python-2.0\""
  },
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@a2ui/angular": "^0.13.0",
    "@a2ui/markdown-it": "^0.2.2",
    "@a2ui/web_core": "^0.14.0",
    "@ag-ui/client": "1.0.3",
    "@angular/aria": "^22.2.5",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@copilotkit/angular": "^0.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/angular": "^1.65.0",
    "@protomaps/basemaps": "^5.7.2",
    "ag-grid-angular": "^36.2.0",
    "ag-grid-community": "^36.2.0",
    "chart.js": "^4.6.1",
    "maplibre-gl": "^6.16.0",
    "ng2-charts": "^11.0.0",
    "pmtiles": "^4.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@angular/build": "~22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "license-checker-rseidelsohn": "^5.0.1",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vite": "8.3.4",
    "zod": "4.6.7",
    "@ag-ui/client": "$@ag-ui/client",
    "@ag-ui/core": "1.0.3",
    "@ag-ui/a2ui-middleware": "0.0.14",
    "dompurify": "3.4.17",
    "minimatch": "11.0.3",
    "glob": "14.0.3",
    "@a2ui/angular": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common",
      "@angular/platform-browser": "$@angular/platform-browser"
    }
  }
}
