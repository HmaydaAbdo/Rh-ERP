# Variables pour docker-compose (voir docker-compose.yml et docs/deployment.md).
# Copier ce fichier en ".env" (jamais commité) et adapter les valeurs.
#
# Stack de PRODUCTION : docker-compose.yml ne contient aucun `build:`, uniquement des `image:`
# publiées sur Docker Hub (buildées par la CI, voir .github/workflows/ci.yml). Toutes les valeurs
# ci-dessous sont obligatoires — l'application (backend) refuse de démarrer si l'une des siennes
# manque (conventions/configuration.md) ; docker-compose refuse de démarrer si une variable qu'il
# référence est absente.

# --- Images Docker Hub ---
# Compte/organisation Docker Hub sous lequel les images sont publiées par la CI.
DOCKERHUB_USERNAME=change-me-dockerhub-username
POSTGRES_IMAGE_TAG=latest
# Tag à déployer — un SHA de commit (ex. "a1b2c3d", poussé par la CI à chaque build sur main) pour
# une version précise, ou "latest" pour toujours suivre le dernier build de main.
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
BACKUP_IMAGE_TAG=latest

# --- PostgreSQL ---
POSTGRES_DB=staport_rh
POSTGRES_USER=staport
POSTGRES_PASSWORD=change-me-strong-password
# Compte APPLICATIF (utilisé par le backend à l'exécution) : n'a que SELECT et INSERT sur les tables d'audit, donc ne peut
# pas réécrire l'historique. POSTGRES_USER, lui, ne sert qu'aux migrations (Flyway). Le compte est créé tout seul au
# démarrage s'il n'existe pas. Mot de passe : sans apostrophe.
POSTGRES_APP_USER=staport_app
POSTGRES_APP_PASSWORD=change-me-another-strong-password

# --- Sauvegardes PostgreSQL ---
# Une sauvegarde complète chaque jour à 02:00 UTC ; les archives de plus de 30 jours sont purgées.
BACKUP_TIME_UTC=02:00
BACKUP_RETENTION_DAYS=30

# --- Ports publiés sur l'hôte (liés à 127.0.0.1 uniquement — voir docker-compose.yml) ---
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=8081

# --- Backend ---
# Endpoint ERP source des chantiers (webServiceBS/getChantiers). Obligatoire :
# l'application refuse de démarrer si cette variable est absente (conventions/security.md).
CHANTIER_SYNC_BASE_URL=http://staport.dyndns.org/webServiceBS/getChantiers

# --- Authentification / RBAC (voir conventions/security.md) ---
# Secret HMAC (HS256) signant les Access Tokens JWT — générer avec `openssl rand -base64 32`,
# jamais réutiliser cette valeur d'exemple.
JWT_SECRET=change-me-generate-a-real-256-bit-base64-secret
# URL publique réelle du frontend (celle que voient les navigateurs, derrière nginx outer) — sert
# au CORS backend. Doit être en HTTPS en production.
FRONTEND_URL=https://your-domain.example
# true dès que l'application est servie en HTTPS (le cas normal en production, via nginx outer) ;
# false uniquement pour un accès direct en HTTP pur (diagnostic local).
COOKIE_SECURE=true

# Compte SYSTEM_ADMIN de bootstrap, créé automatiquement au premier démarrage si aucun SYSTEM_ADMIN
# n'existe déjà en base (voir AdminBootstrapRunner). À changer via l'UI après la première connexion.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Email (mot de passe oublié) — vrai fournisseur SMTP en production ---
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=noreply@your-domain.example
