# Variables pour docker-compose (voir docker-compose.yml et docs/deployment.md).
# Copier ce fichier en ".env" (jamais commité) et adapter les valeurs.
#
# Stack de PRODUCTION : docker-compose.yml ne contient aucun `build:`, uniquement des `image:`
# publiées sur Docker Hub (buildées par la CI, voir .github/workflows/ci.yml). Toutes les valeurs
# ci-dessous sont obligatoires — l'application (backend) refuse de démarrer si l'une des siennes
# manque (conventions/configuration.md) ; docker-compose refuse de démarrer si une variable qu'il
# référence est absente.

# --- Images Docker Hub ---
# Compte/organisation Docker Hub sous lequel les images sont publiées par la CI.
DOCKERHUB_USERNAME=change-me-dockerhub-username
# Sur l'hôte de production, décommenter pour inclure automatiquement les services de sauvegarde et
# de rétention pgAudit dans les commandes `docker compose` sans passer --profile à chaque fois.
# COMPOSE_PROFILES=backup
# La production suit `latest` après validation de la CI sur main (décision ADR 0004).
# Les quatre images sont publiées ensemble par le workflow CI.
POSTGRES_IMAGE_TAG=latest
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
BACKUP_IMAGE_TAG=latest
# Clé publique age pour chiffrer les archives (générer localement avec `age-keygen`).
# Garder la clé privée séparément ; remplacer ce placeholder avant d'activer le profil backup.
BACKUP_AGE_RECIPIENT=change-me-age-recipient

# --- PostgreSQL ---
POSTGRES_DB=staport_rh
POSTGRES_USER=staport
POSTGRES_PASSWORD=change-me-strong-password
# Compte APPLICATIF (utilisé par le backend à l'exécution) : n'a que SELECT et INSERT sur les tables d'audit, donc ne peut
# pas réécrire l'historique. POSTGRES_USER, lui, ne sert qu'aux migrations (Flyway). Le compte est créé tout seul au
# démarrage s'il n'existe pas. Mot de passe : sans apostrophe.
POSTGRES_APP_USER=staport_app
POSTGRES_APP_PASSWORD=change-me-another-strong-password

# --- Sauvegardes PostgreSQL ---
# Une sauvegarde complète chaque jour à 02:00 UTC ; les archives de plus de 30 jours sont purgées.
BACKUP_TIME_UTC=02:00
BACKUP_RETENTION_DAYS=30

# --- Ports publiés sur l'hôte (liés à 127.0.0.1 uniquement — voir docker-compose.yml) ---
POSTGRES_PORT=5000
BACKEND_PORT=5001
FRONTEND_PORT=5002

# --- Carte des chantiers ---
# Dossier de l'hôte contenant le fond de carte (monde.pmtiles, monde-relief.pmtiles, fonts/, sprites/), produit par
# scripts/carte/preparer-fond-carte.sh et monté en lecture seule dans le frontend. Défaut : ./carte-fond
CARTE_FOND_DIR=./carte-fond
# Clé ArcGIS Location Platform de l'imagerie satellite (privilège « Basemaps »), ajoutée aux tuiles par le nginx du
# frontend : elle n'arrive jamais au navigateur. Obligatoire : docker compose et ng serve refusent de démarrer sans elle.
# Création pas à pas : docs/chantier/carte.md, « Clé ArcGIS ».
ARCGIS_API_KEY=

# --- Backend ---
# Endpoint ERP source des chantiers (webServiceBS/getChantiers). Obligatoire :
# l'application refuse de démarrer si cette variable est absente (conventions/security.md).
CHANTIER_SYNC_BASE_URL=http://staport.dyndns.org/webServiceBS/getChantiers

# --- Authentification / RBAC (voir conventions/security.md) ---
# Secret HMAC (HS256) signant les Access Tokens JWT — générer avec `openssl rand -base64 32`,
# jamais réutiliser cette valeur d'exemple.
JWT_SECRET=change-me-generate-a-real-256-bit-base64-secret
# URL publique complète du frontend (celle que voient les navigateurs, derrière nginx outer) — sert
# à construire les liens d'e-mail. Doit être en HTTPS en production.
FRONTEND_URL=https://your-domain.example
# Origines navigateur autorisées par CORS, séparées par des virgules (origine = schéma+hôte+port,
# sans chemin ni wildcard). Doit correspondre aux environnements réellement déployés.
CORS_ALLOWED_ORIGINS=https://your-domain.example
# true dès que l'application est servie en HTTPS (le cas normal en production, via nginx outer) ;
# false uniquement pour un accès direct en HTTP pur (diagnostic local).
COOKIE_SECURE=true

# Compte SYSTEM_ADMIN de bootstrap, créé automatiquement au premier démarrage si aucun SYSTEM_ADMIN
# n'existe déjà en base (voir AdminBootstrapRunner). À changer via l'UI après la première connexion.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Email (mot de passe oublié) — vrai fournisseur SMTP en production ---
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=noreply@your-domain.example

# --- IA (profil Compose « ia », voir docs/ia.md et litellm/README.md) ---
# Activer avec COMPOSE_PROFILES=ia (ou --profile ia). Sans ce profil, ces variables sont ignorées.
# Les images suivent `latest` comme les autres images publiées par la CI.
LITELLM_IMAGE_TAG=latest
IA_IMAGE_TAG=latest
# Ports publiés sur 127.0.0.1 uniquement.
LITELLM_PORT=4000
IA_PORT=5003
# Passerelle LiteLLM : clé master (administration seulement, jamais donnée à une application) et sel
# de chiffrement des identifiants stockés. Générer avec `python -c "import secrets;print('sk-'+secrets.token_hex(32))"`.
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me-different
# Mot de passe de la base dédiée de LiteLLM (conteneur litellm-db). Vide : PostgreSQL refuse de démarrer.
LITELLM_DB_PASSWORD=change-me-random-hex
# Fournisseurs. Une clé vide ne casse pas la passerelle : ses modèles passent en cooldown et le routeur
# bascule. Paliers gratuits : données publiques ou synthétiques uniquement (docs/ia.md, § 2).
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
# Pool d'évaluation seulement (tags eval…) : conditions excluant la production.
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
# Tests de la passerelle (litellm/test_providers.py) : URL et clé virtuelle de test, jamais la clé master.
LITELLM_GATEWAY_URL=http://127.0.0.1:4000/v1/chat/completions
LITELLM_TEST_API_KEY=
# Route /mcp du backend et jeton délégué de l'agent (RS256, 5 minutes). Avec MCP_ENABLED=true, le backend refuse de
# démarrer sans clé privée RSA 3072 bits : base64 d'un PKCS#8 DER, sur une seule ligne, par exemple
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -outform DER | base64 -w0
# Changement de clé : la clé publique précédente (base64 d'un X.509 DER) et son identifiant restent acceptés
# jusqu'à l'expiration des jetons émis avec elle (voir docs/ia.md, § 5).
MCP_ENABLED=false
MCP_JWT_PRIVATE_KEY=
MCP_JWT_KEY_ID=
MCP_JWT_PREVIOUS_PUBLIC_KEY=
MCP_JWT_PREVIOUS_KEY_ID=
# Service IA : interrupteur global et clé virtuelle LiteLLM d'ERP-RH (créée avec metadata.tags ["!eval"]).
IA_ENABLED=false
IA_LITELLM_API_KEY=
