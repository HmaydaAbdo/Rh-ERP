	<properties>
		<java.version>21</java.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<archunit.version>1.5.1</archunit.version>
		<jacoco.version>0.8.15</jacoco.version>
		<cyclonedx.version>2.9.3</cyclonedx.version>
		<!-- Correctifs de sécurité plus récents que ceux de la BOM de Spring Boot 4.1.1 (analyse OSV du 2026-10-11) :
		     à retirer quand la BOM les rattrape. Tomcat : contournement d'authentification et
		     contrôle d'accès (GHSA-9xv2-5v5q-p794, GHSA-gcx9-497g-6cp6, GHSA-h3x4-894j-xpx5) ; Jackson : dénis de service. -->
		<tomcat.version>11.0.26</tomcat.version>
		<jackson-2-bom.version>2.21.7</jackson-2-bom.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
		<jsoup.version>1.23.2</jsoup.version>
		<!-- Batik arrive par openhtmltopdf-svg-support 1.0.10 en 1.14 (plusieurs SSRF et exécution de code, corrigés en 1.17) ;
		     Xalan 2.7.2 par Batik (GHSA-9339-86wc-4qgf, corrigé en 2.7.3). -->
		<batik.version>1.19</batik.version>
		<xalan.version>2.7.3</xalan.version>
	</properties>
