<?xml version="1.0" encoding="UTF-8"?>
<!-- Déclare la famille "Liberation Serif" comme extension de police JasperReports embarquée dans
     l'application (fichiers .ttf en resources, jamais une dépendance à une police installée sur le
     système d'exploitation qui exécute le backend). Découvert automatiquement au démarrage via
     resources/jasperreports_extension.properties (convention JasperReports : tout fichier de ce nom
     sur le classpath est fusionné). Sans cette extension, un environnement de déploiement sans la
     police "Liberation Serif" installée au niveau OS lève JRFontNotFoundException dès le premier
     remplissage (voir docs/report/README.md, section « Style visuel ») — ce fut le cas en production,
     alors que ce même rapport se générait sans erreur dans un environnement de développement où la
     police était, elle, installée système. -->
<fontFamilies xmlns="http://jasperreports.sourceforge.net/fonts"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/fonts http://jasperreports.sourceforge.net/xsd/fonts.xsd">
    <fontFamily name="Liberation Serif">
        <normal>report/paie/fonts/LiberationSerif-Regular.ttf</normal>
        <bold>report/paie/fonts/LiberationSerif-Bold.ttf</bold>
        <italic>report/paie/fonts/LiberationSerif-Italic.ttf</italic>
        <boldItalic>report/paie/fonts/LiberationSerif-BoldItalic.ttf</boldItalic>
        <pdfEncoding>Identity-H</pdfEncoding>
        <pdfEmbedded>true</pdfEmbedded>
    </fontFamily>
</fontFamilies>
