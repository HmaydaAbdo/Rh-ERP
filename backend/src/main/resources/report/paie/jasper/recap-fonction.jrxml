<?xml version="1.0" encoding="UTF-8"?>
<!-- Sous-rapport du tableau récap "Fonction / Effectif / STC" de chaque section équipe du rapport
     PDF (voir rapport.jrxml, GroupEquipe) — nombre de fonctions variable d'une section à l'autre,
     imprimé via un sous-rapport plutôt qu'un nombre fixe d'éléments JRXML (seul mécanisme
     JasperReports permettant à une bande parente de s'étirer pour un nombre de lignes inconnu à la
     compilation). Champs alimentés par RepartitionBean (staport.rh.paie.report), déjà utilisé comme
     source de données des <barChart> du gabarit principal — seuls libelle/effectif/stc sont utilisés
     ici, montant/stcMontant n'ont pas leur place dans ce tableau (demande explicite de direction,
     2026-09-29 : Fonction/Effectif/STC uniquement, jamais de masse salariale). Aucune pagination
     propre : ce sous-rapport est toujours entièrement contenu dans la page où il est invoqué (une
     équipe compte peu de fonctions distinctes). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="recap-fonction" pageWidth="300" pageHeight="1000" columnWidth="300"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">

    <property name="net.sf.jasperreports.default.font.name" value="Liberation Serif"/>

    <field name="libelle" class="java.lang.String"/>
    <field name="effectif" class="java.lang.Integer"/>
    <field name="stc" class="java.lang.Integer"/>

    <columnHeader>
        <band height="18" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="160" height="18" forecolor="#000000"/>
                <box><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="Liberation Serif" size="9.5" isBold="true"/><paragraph leftIndent="4"/></textElement>
                <text><![CDATA[FONCTION]]></text>
            </staticText>
            <staticText>
                <reportElement x="160" y="0" width="70" height="18" forecolor="#000000"/>
                <box><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Liberation Serif" size="9.5" isBold="true"/></textElement>
                <text><![CDATA[EFFECTIF]]></text>
            </staticText>
            <staticText>
                <reportElement x="230" y="0" width="70" height="18" forecolor="#000000"/>
                <box><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Liberation Serif" size="9.5" isBold="true"/></textElement>
                <text><![CDATA[STC]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="15" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="160" height="15" forecolor="#000000"/>
                <box><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="Liberation Serif" size="9"/><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{libelle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="160" y="0" width="70" height="15" forecolor="#000000"/>
                <box><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Liberation Serif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{effectif}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="230" y="0" width="70" height="15" forecolor="#000000"/>
                <box><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Liberation Serif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{stc}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
