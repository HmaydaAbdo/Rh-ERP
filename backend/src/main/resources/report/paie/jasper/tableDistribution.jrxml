<?xml version="1.0" encoding="UTF-8"?>
<!-- Table "Répartition par équipe" OU "par fonction" d'un chantier — sous-rapport partagé intégré
     dans le groupe GroupChantier de rapport.jrxml, invoqué une fois par dimension (P_TITRE/
     P_LIBELLE_COLONNE paramétrent le seul texte qui diffère entre les deux usages). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="tableDistribution" pageWidth="390" pageHeight="800"
              columnWidth="390" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">

    <property name="net.sf.jasperreports.default.font.name" value="Liberation Serif"/>

    <parameter name="P_TITRE" class="java.lang.String"/>
    <parameter name="P_LIBELLE_COLONNE" class="java.lang.String"/>

    <field name="libelle" class="java.lang.String"/>
    <field name="effectif" class="java.lang.Integer"/>
    <field name="montant" class="java.lang.String"/>
    <field name="pourcentage" class="java.lang.String"/>

    <title>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="390" height="16" forecolor="#000000"/>
                <textElement><font fontName="Liberation Serif" size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TITRE}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="180" height="18" mode="Opaque" backcolor="#000000" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="Liberation Serif" size="10.5" isBold="true"/><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$P{P_LIBELLE_COLONNE}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="180" y="0" width="60" height="18" mode="Opaque" backcolor="#000000" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Liberation Serif" size="10.5" isBold="true"/></textElement>
                <text><![CDATA[Effectif]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="0" width="90" height="18" mode="Opaque" backcolor="#000000" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Liberation Serif" size="10.5" isBold="true"/><paragraph rightIndent="4"/></textElement>
                <text><![CDATA[Montant]]></text>
            </staticText>
            <staticText>
                <reportElement x="330" y="0" width="60" height="18" mode="Opaque" backcolor="#000000" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Liberation Serif" size="10.5" isBold="true"/><paragraph rightIndent="4"/></textElement>
                <text><![CDATA[Part]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16" splitType="Prevent">
            <rectangle>
                <reportElement x="0" y="0" width="390" height="16" mode="Opaque" backcolor="#F2F2F2">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="0" y="0" width="180" height="16"/>
                <box leftPadding="4" bottomPadding="1"><bottomPen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Liberation Serif" size="11"/></textElement>
                <textFieldExpression><![CDATA[$F{libelle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="180" y="0" width="60" height="16"/>
                <box bottomPadding="1"><bottomPen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Liberation Serif" size="11"/></textElement>
                <textFieldExpression><![CDATA[$F{effectif}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="240" y="0" width="90" height="16"/>
                <box rightPadding="4" bottomPadding="1"><bottomPen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Liberation Serif" size="11"/></textElement>
                <textFieldExpression><![CDATA[$F{montant} + " DH"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="0" width="60" height="16"/>
                <box rightPadding="4" bottomPadding="1"><bottomPen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Liberation Serif" size="11"/></textElement>
                <textFieldExpression><![CDATA[$F{pourcentage}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
