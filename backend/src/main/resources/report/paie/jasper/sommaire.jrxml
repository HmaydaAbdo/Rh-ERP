<?xml version="1.0" encoding="UTF-8"?>
<!-- Sommaire du rapport BI paie — sous-rapport de rapport.jrxml, une ligne par section (chapitres BI
     puis un chantier par ligne, dans l'ordre où elles apparaissent dans le document) avec le numéro
     de page où elle démarre. Les numéros de page réels ne sont connus qu'après un premier
     remplissage silencieux du document (voir PaieReportPdfService, double passage) — ce sous-rapport
     est rempli deux fois avec le même gabarit, la seconde fois avec les vrais numéros. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sommaire" pageWidth="802" pageHeight="800"
              columnWidth="802" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">

    <property name="net.sf.jasperreports.default.font.name" value="Liberation Serif"/>

    <field name="titre" class="java.lang.String"/>
    <field name="numeroPage" class="java.lang.Integer"/>

    <title>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="802" height="28" forecolor="#000000"/>
                <textElement><font fontName="Liberation Serif" size="22" isBold="true"/></textElement>
                <text><![CDATA[Sommaire]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="32" width="802" height="0" forecolor="#000000"/>
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </line>
        </band>
    </title>

    <detail>
        <!-- 100% noir et blanc, aucune alternance de fond (demande explicite de direction) — chaque
             ligne reste séparée par le seul filet gris clair déjà porté par les <box> ci-dessous. -->
        <band height="24" splitType="Prevent">
            <textField>
                <reportElement x="0" y="2" width="700" height="20"/>
                <box leftPadding="4" bottomPadding="2"><bottomPen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Liberation Serif" size="13"/></textElement>
                <textFieldExpression><![CDATA[$F{titre}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="750" y="2" width="52" height="20"/>
                <box rightPadding="4" bottomPadding="2"><bottomPen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Liberation Serif" size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["p. " + $F{numeroPage}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
