<?xml version="1.0" encoding="UTF-8"?>
<!-- Table "Effectif par fonction" (+ STC) d'un chantier — sous-rapport de chantierSection.jrxml. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="tableEffectifFonction" pageWidth="390" pageHeight="800"
              columnWidth="390" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">

    <property name="net.sf.jasperreports.default.font.name" value="DejaVu Sans"/>

    <field name="fonction" class="java.lang.String"/>
    <field name="effectif" class="java.lang.Integer"/>
    <field name="stc" class="java.lang.Integer"/>

    <title>
        <band height="12">
            <staticText>
                <reportElement x="0" y="0" width="390" height="12" forecolor="#1E3A8A"/>
                <textElement><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
                <text><![CDATA[EFFECTIF PAR FONCTION]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="14">
            <staticText>
                <reportElement x="0" y="0" width="240" height="14" mode="Opaque" backcolor="#1E3A8A" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="6.5" isBold="true"/><paragraph leftIndent="4"/></textElement>
                <text><![CDATA[Fonction]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="0" width="75" height="14" mode="Opaque" backcolor="#1E3A8A" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="6.5" isBold="true"/></textElement>
                <text><![CDATA[Effectif]]></text>
            </staticText>
            <staticText>
                <reportElement x="315" y="0" width="75" height="14" mode="Opaque" backcolor="#1E3A8A" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="6.5" isBold="true"/></textElement>
                <text><![CDATA[STC / sortie]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="12" splitType="Prevent">
            <rectangle>
                <reportElement x="0" y="0" width="390" height="12" mode="Opaque" backcolor="#F8FAFC">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="0" y="0" width="240" height="12"/>
                <box leftPadding="4" bottomPadding="1"><bottomPen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="6.5"/></textElement>
                <textFieldExpression><![CDATA[$F{fonction}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="240" y="0" width="75" height="12"/>
                <box bottomPadding="1"><bottomPen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="6.5"/></textElement>
                <textFieldExpression><![CDATA[$F{effectif}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="315" y="0" width="75" height="12"/>
                <box bottomPadding="1"><bottomPen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="6.5"/></textElement>
                <textFieldExpression><![CDATA[$F{stc}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
