                    <text><![CDATA[Nbre jrs]]></text>
                </staticText>
                <staticText>
                    <reportElement x="285" y="38" width="35" height="18" mode="Opaque" backcolor="#000000" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Liberation Serif" size="9"/></textElement>
                    <text><![CDATA[P]]></text>
                </staticText>
                <staticText>
                    <reportElement x="320" y="38" width="40" height="18" mode="Opaque" backcolor="#000000" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Liberation Serif" size="9"/></textElement>
                    <text><![CDATA[J.R.O]]></text>
                </staticText>
                <staticText>
                    <reportElement x="360" y="38" width="40" height="18" mode="Opaque" backcolor="#000000" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Liberation Serif" size="9"/></textElement>
                    <text><![CDATA[J.R.D]]></text>
                </staticText>
                <staticText>
                    <reportElement x="400" y="20" width="175" height="18" mode="Opaque" backcolor="#000000" forecolor="#FFFFFF"/>
