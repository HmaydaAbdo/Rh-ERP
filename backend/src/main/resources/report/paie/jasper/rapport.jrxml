                    <textElement verticalAlignment="Middle"><font fontName="Liberation Serif" size="10.5" isBold="true"/><paragraph leftIndent="4"/></textElement>
                    <text><![CDATA[Nom et prénom]]></text>
                </staticText>
                <staticText>
                    <reportElement x="130" y="20" width="90" height="36" mode="Opaque" backcolor="#000000" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font fontName="Liberation Serif" size="10.5" isBold="true"/><paragraph leftIndent="4"/></textElement>
                    <text><![CDATA[Fonction]]></text>
                </staticText>
                <staticText>
                    <reportElement x="220" y="20" width="65" height="36" mode="Opaque" backcolor="#000000" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Liberation Serif" size="10.5" isBold="true"/></textElement>
                    <text><![CDATA[CIN]]></text>
                </staticText>
                <staticText>
                    <reportElement x="285" y="20" width="115" height="18" mode="Opaque" backcolor="#000000" forecolor="#FFFFFF"/>
