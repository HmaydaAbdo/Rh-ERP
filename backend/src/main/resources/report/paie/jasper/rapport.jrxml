<?xml version="1.0" encoding="UTF-8"?>
<!-- Rapport de paie — Synthèse BI. Gabarit unique pour tout le document : le pageHeader/pageFooter
     ne sont définis qu'une seule fois ici et se répètent donc nativement sur toutes les pages de
     contenu (page de garde exceptée, voir plus bas), y compris pendant le déroulé des groupes
     Sommaire/Synthèse/Chantier/Équipe — jamais de bande dupliquée dans un second gabarit (voir
     docs/report/README.md). Structure en pages, dans l'ordre :
       1. Page de garde (bande title, isTitleNewPage) : logo, titre, période — JasperReports
          n'imprime jamais pageHeader/pageFooter sur cette page dédiée, ce qui convient à une
          couverture (elle porte déjà sa propre mise en avant de la période/logo).
       2. Sommaire (groupe GroupSommaire, expression constante donc imprimé une seule fois en tout
          début de document) : une ligne par section avec son numéro de page réel — nécessite un
          double remplissage (voir PaieReportPdfService), jamais un JasperPrint fusionné après coup.
       3. Synthèse globale (groupe GroupSynthese, même mécanique d'impression unique) : KPI +
          narratif + évolution mensuelle (masse et effectif, 12 derniers mois, 2 <lineChart> côte à
          côte) — chapitre I, voir PaieReportEvolutionChartCustomizer.
       4. Chapitre II — Répartition par chantier (GroupGraphChantierMasse puis
          GroupGraphChantierEffectif), sur 2 pages : un seul graphique par page, pleine largeur,
          jamais deux côte à côte, plafonné aux 20 plus gros chantiers + "Autres" (voir
          PaieBiReportBuilder.MAX_BARRES_GRAPHIQUE, PaieReportChartCustomizer). Seule la 1ʳᵉ page
          porte le titre de chapitre/l'ancre, la 2ᵉ est sa suite directe. Chapitre III — Répartition
          par fonction retiré temporairement (doublons non nettoyés dans le référentiel Fonction, voir
          TODO.md).
       5. Une section par chantier (GroupChantier, isStartNewPage), numérotée en chiffre romain à la
          suite des chapitres fixes (voir PaieReportPdfService.chapitreChantier — I/II fixes, III et
          suivants un par chantier, même numérotation reflétée dans le Sommaire), puis par équipe
          (GroupEquipe, keepTogether) pilotées par la même source de données à plat (un employé par
          ligne).
     Style documentaire entièrement noir/blanc/gris (aucune couleur décorative) — seuls les
     <barChart> conservent une couleur (bleu). Police Liberation Serif partout (substitut fiable de
     Times New Roman : métriquement compatible, réellement installée et résolue par le moteur PDF de
     JasperReports — voir docs/report/README.md). Un seul remplissage réellement exporté
     (JasperFillManager + JRPdfExporter), une seule source de données à plat
     (LigneRapportDetailBean). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rapport" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              isTitleNewPage="true">

    <property name="net.sf.jasperreports.default.font.name" value="Liberation Serif"/>

    <!-- Source de données des barChart (masse/effectif par chantier ou par fonction) — même forme
         (libellé, effectif, montant), voir RepartitionBean. -->
    <subDataset name="dsRepartition">
        <field name="libelle" class="java.lang.String"/>
        <field name="effectif" class="java.lang.Integer"/>
        <field name="montant" class="java.math.BigDecimal"/>
    </subDataset>

    <!-- Source du stackedBarChart Équipe × Fonction d'un chantier (voir CroisementBean) — une ligne
         à plat par paire, JasperReports construit dynamiquement une série par valeur distincte de
         "fonction" trouvée dans les données (categorySeries ci-dessous a des expressions de champ,
         pas des constantes comme dsRepartition — c'est ce qui permet un nombre de séries variable
         d'un chantier à l'autre, jamais une série codée en dur par fonction). -->
    <subDataset name="dsCroisement">
        <field name="equipe" class="java.lang.String"/>
        <field name="fonction" class="java.lang.String"/>
        <field name="montant" class="java.math.BigDecimal"/>
    </subDataset>

    <!-- byte[] et non InputStream : le logo est référencé par PLUSIEURS <image> (page de garde +
         pageHeader répété sur chaque page) — un InputStream ne se lit qu'une fois, la deuxième
         référence obtiendrait un flux déjà épuisé (image blanche). byte[] est réévaluable à volonté. -->
    <parameter name="P_LOGO" class="byte[]"/>
    <parameter name="P_PERIODE_LIBELLE" class="java.lang.String"/>
    <parameter name="P_PERIODE_MOIS" class="java.lang.String"/>
    <parameter name="P_PERIODE_ANNEE" class="java.lang.String"/>
    <parameter name="P_DATE_GENERATION" class="java.lang.String"/>
    <parameter name="P_MASSE_VALEUR" class="java.lang.String"/>
    <parameter name="P_MASSE_VARIATION" class="java.lang.String"/>
    <parameter name="P_MASSE_TENDANCE" class="java.lang.String"/>
    <parameter name="P_MASSE_NOTE" class="java.lang.String"/>
    <parameter name="P_EFFECTIF_VALEUR" class="java.lang.String"/>
    <parameter name="P_EFFECTIF_NOTE" class="java.lang.String"/>
    <parameter name="P_MASSE_MOYENNE" class="java.lang.String"/>
    <parameter name="P_NOMBRE_CHANTIERS" class="java.lang.String"/>
    <parameter name="P_REPARTITION_CHANTIER" class="java.util.List"/>
    <parameter name="P_REPARTITION_FONCTION" class="java.util.List"/>
    <parameter name="P_EVOLUTION_MENSUELLE" class="java.util.List"/>
    <parameter name="P_SYNTHESE_NARRATIF" class="java.lang.String"/>
    <parameter name="P_SOMMAIRE_ENTREES" class="java.util.List"/>
    <parameter name="SUBREPORT_DISTRIBUTION" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUBREPORT_SOMMAIRE" class="net.sf.jasperreports.engine.JasperReport"/>

    <field name="chantierCode" class="java.lang.String"/>
    <field name="chantierTitre" class="java.lang.String"/>
    <field name="chantierMasseLigne" class="java.lang.String"/>
    <field name="chantierMasseMoyenneParEmploye" class="java.lang.String"/>
    <field name="chantierEffectifValeur" class="java.lang.String"/>
    <field name="chantierEffectifNote" class="java.lang.String"/>
    <field name="chantierPartMasseGlobale" class="java.lang.String"/>
    <field name="chantierStc" class="java.lang.Integer"/>
    <field name="chantierNarratif" class="java.lang.String"/>
    <field name="chantierDistributionEquipe" class="java.util.List"/>
    <field name="chantierDistributionFonction" class="java.util.List"/>
    <field name="chantierCroisementEquipeFonction" class="java.util.List"/>
    <field name="equipeNom" class="java.lang.String"/>
    <field name="equipeTitre" class="java.lang.String"/>
    <field name="equipeEffectif" class="java.lang.Integer"/>
    <field name="equipeMasse" class="java.lang.String"/>
    <field name="equipePartChantierPourcent" class="java.lang.String"/>
    <field name="nomPrenom" class="java.lang.String"/>
    <field name="fonction" class="java.lang.String"/>
    <field name="cin" class="java.lang.String"/>
    <field name="joursTravailles" class="java.lang.Integer"/>
    <field name="joursRecuperationOuvrable" class="java.lang.String"/>
    <field name="joursRecuperationDimanche" class="java.lang.String"/>
    <field name="salaireMensuel" class="java.lang.String"/>
    <field name="primeRoulageOrdinaire" class="java.lang.String"/>
    <field name="primeRoulageDimanche" class="java.lang.String"/>
    <field name="salaireTotal" class="java.lang.String"/>
    <field name="observation" class="java.lang.String"/>

    <!-- Groupes à expression constante : leur en-tête s'imprime une seule fois, au tout début du
         document (le premier enregistrement fait toujours "changer" l'expression depuis null) —
         c'est ce qui permet d'insérer Sommaire, Synthèse globale puis les 2 pages BI avant le
         déroulé des chantiers sans les driver par un enregistrement dédié dans la source de données. -->
    <group name="GroupSommaire" isStartNewColumn="false" isStartNewPage="true" isReprintHeaderOnEachPage="false" keepTogether="false">
        <groupExpression><![CDATA["SOMMAIRE"]]></groupExpression>
        <groupHeader>
            <band height="455" splitType="Stretch">
                <subreport>
                    <reportElement x="0" y="0" width="802" height="455"/>
                    <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{P_SOMMAIRE_ENTREES})]]></dataSourceExpression>
                    <subreportExpression><![CDATA[$P{SUBREPORT_SOMMAIRE}]]></subreportExpression>
                </subreport>
            </band>
        </groupHeader>
    </group>

    <group name="GroupSynthese" isStartNewColumn="false" isStartNewPage="true" isReprintHeaderOnEachPage="false" keepTogether="false">
        <groupExpression><![CDATA["SYNTHESE"]]></groupExpression>
        <groupHeader>
            <band height="455" splitType="Stretch">

                <!-- ============================== I — SYNTHÈSE GLOBALE ==============================
                     textField (pas staticText) : seul <textField> porte anchorNameExpression dans le
                     schéma JRXML — l'ancre est ce qui permet à PaieReportPdfService de retrouver le
                     numéro de page réel de cette section pour le Sommaire (voir docs/report/README.md). -->
                <textField>
                    <reportElement x="0" y="0" width="802" height="22" forecolor="#000000"/>
                    <textElement verticalAlignment="Bottom"><font fontName="Liberation Serif" size="16" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["I — SYNTHÈSE GLOBALE"]]></textFieldExpression>
                    <anchorNameExpression><![CDATA["synthese-globale"]]></anchorNameExpression>
                </textField>
                <line>
                    <reportElement x="0" y="23" width="802" height="0" forecolor="#000000"/>
                    <graphicElement><pen lineWidth="1.0"/></graphicElement>
                </line>

                <!-- KPI : masse réelle de paie -->
                <rectangle>
                    <reportElement x="0" y="34" width="192" height="78" mode="Transparent"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/></graphicElement>
                </rectangle>
                <staticText>
                    <reportElement x="8" y="42" width="176" height="11" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="9" isBold="true"/></textElement>
                    <text><![CDATA[MASSE]]></text>
                </staticText>
                <textField>
                    <reportElement x="8" y="56" width="176" height="24" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="18" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{P_MASSE_VALEUR} + " DH"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="8" y="84" width="176" height="20" forecolor="#000000">
                        <printWhenExpression><![CDATA["HAUSSE".equals($P{P_MASSE_TENDANCE})]]></printWhenExpression>
                    </reportElement>
                    <textElement><font fontName="Liberation Serif" size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["Hausse : " + $P{P_MASSE_VARIATION}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="8" y="84" width="176" height="20" forecolor="#000000">
                        <printWhenExpression><![CDATA["BAISSE".equals($P{P_MASSE_TENDANCE})]]></printWhenExpression>
                    </reportElement>
                    <textElement><font fontName="Liberation Serif" size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["Baisse : " + $P{P_MASSE_VARIATION}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="8" y="84" width="176" height="20" forecolor="#000000">
                        <printWhenExpression><![CDATA["STABLE".equals($P{P_MASSE_TENDANCE})]]></printWhenExpression>
                    </reportElement>
                    <textElement><font fontName="Liberation Serif" size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["Stable : " + $P{P_MASSE_VARIATION}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="8" y="84" width="176" height="20" forecolor="#595959">
                        <printWhenExpression><![CDATA["NON_DISPONIBLE".equals($P{P_MASSE_TENDANCE})]]></printWhenExpression>
                    </reportElement>
                    <textElement><font fontName="Liberation Serif" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$P{P_MASSE_NOTE}]]></textFieldExpression>
                </textField>

                <!-- KPI : effectif -->
                <rectangle>
                    <reportElement x="200" y="34" width="192" height="78" mode="Transparent"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/></graphicElement>
                </rectangle>
                <staticText>
                    <reportElement x="208" y="42" width="176" height="11" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="9" isBold="true"/></textElement>
                    <text><![CDATA[EFFECTIF]]></text>
                </staticText>
                <textField>
                    <reportElement x="208" y="56" width="176" height="24" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="18" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{P_EFFECTIF_VALEUR}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="208" y="84" width="176" height="20" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$P{P_EFFECTIF_NOTE}]]></textFieldExpression>
                </textField>

                <!-- KPI : masse moyenne par employé -->
                <rectangle>
                    <reportElement x="400" y="34" width="192" height="78" mode="Transparent"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/></graphicElement>
                </rectangle>
                <staticText>
                    <reportElement x="408" y="42" width="176" height="11" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="9" isBold="true"/></textElement>
                    <text><![CDATA[MASSE MOYENNE / EMPLOYÉ]]></text>
                </staticText>
                <textField>
                    <reportElement x="408" y="56" width="176" height="24" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="18" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{P_MASSE_MOYENNE} + " DH"]]></textFieldExpression>
                </textField>

                <!-- KPI : nombre de chantiers -->
                <rectangle>
                    <reportElement x="600" y="34" width="192" height="78" mode="Transparent"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/></graphicElement>
                </rectangle>
                <staticText>
                    <reportElement x="608" y="42" width="176" height="11" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="9" isBold="true"/></textElement>
                    <text><![CDATA[CHANTIERS]]></text>
                </staticText>
                <textField>
                    <reportElement x="608" y="56" width="176" height="24" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="18" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{P_NOMBRE_CHANTIERS}]]></textFieldExpression>
                </textField>

                <!-- Narratif léger : phrase courte de synthèse, sous les cartes KPI -->
                <textField>
                    <reportElement x="0" y="122" width="802" height="16" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="10.5" isItalic="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{P_SYNTHESE_NARRATIF}]]></textFieldExpression>
                </textField>

                <!-- Évolution mensuelle (masse et effectif, 12 derniers mois) — 2 <lineChart> côte à
                     côte, même principe que les pages II/III (jamais empilés verticalement). -->
                <staticText>
                    <reportElement x="0" y="150" width="390" height="16" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="13" isBold="true"/></textElement>
                    <text><![CDATA[Évolution de la masse salariale (12 derniers mois)]]></text>
                </staticText>
                <lineChart>
                    <chart customizerClass="staport.rh.paie.report.PaieReportEvolutionChartCustomizer">
                        <reportElement x="0" y="170" width="390" height="275"/>
                    </chart>
                    <categoryDataset>
                        <dataset>
                            <datasetRun subDataset="dsRepartition">
                                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{P_EVOLUTION_MENSUELLE})]]></dataSourceExpression>
                            </datasetRun>
                        </dataset>
                        <categorySeries>
                            <seriesExpression><![CDATA["Masse (DH)"]]></seriesExpression>
                            <categoryExpression><![CDATA[$F{libelle}]]></categoryExpression>
                            <valueExpression><![CDATA[$F{montant}]]></valueExpression>
                        </categorySeries>
                    </categoryDataset>
                    <linePlot><plot/></linePlot>
                </lineChart>

                <staticText>
                    <reportElement x="412" y="150" width="390" height="16" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="13" isBold="true"/></textElement>
                    <text><![CDATA[Évolution de l'effectif (12 derniers mois)]]></text>
                </staticText>
                <lineChart>
                    <chart customizerClass="staport.rh.paie.report.PaieReportEvolutionChartCustomizer">
                        <reportElement x="412" y="170" width="390" height="275"/>
                    </chart>
                    <categoryDataset>
                        <dataset>
                            <datasetRun subDataset="dsRepartition">
                                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{P_EVOLUTION_MENSUELLE})]]></dataSourceExpression>
                            </datasetRun>
                        </dataset>
                        <categorySeries>
                            <seriesExpression><![CDATA["Effectif"]]></seriesExpression>
                            <categoryExpression><![CDATA[$F{libelle}]]></categoryExpression>
                            <valueExpression><![CDATA[$F{effectif}]]></valueExpression>
                        </categorySeries>
                    </categoryDataset>
                    <linePlot><plot/></linePlot>
                </lineChart>
            </band>
        </groupHeader>
    </group>

    <!-- Chapitre II — Répartition par chantier, sur 2 pages : un seul graphique par page (jamais 2
         côte à côte), pleine largeur, pour des barres aussi épaisses et lisibles que possible.
         Orientation HORIZONTAL : la hauteur du plot ÷ le nombre de catégories détermine l'épaisseur
         de chaque barre (voir PaieReportChartCustomizer) — l'étiquette de valeur est à l'extérieur de
         chaque barre, jamais tronquée même pour un petit chantier. Seule la 1ʳᵉ page (masse) porte le
         titre de chapitre numéroté et l'ancre (voir Sommaire) ; la 2ᵉ page (effectif) en est la suite
         directe, jamais un chapitre séparé. -->
    <group name="GroupGraphChantierMasse" isStartNewColumn="false" isStartNewPage="true" isReprintHeaderOnEachPage="false" keepTogether="false">
        <groupExpression><![CDATA["GRAPH_CHANTIER_MASSE"]]></groupExpression>
        <groupHeader>
            <band height="455" splitType="Stretch">
                <textField>
                    <reportElement x="0" y="0" width="802" height="22" forecolor="#000000"/>
                    <textElement verticalAlignment="Bottom"><font fontName="Liberation Serif" size="16" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["II — RÉPARTITION PAR CHANTIER"]]></textFieldExpression>
                    <anchorNameExpression><![CDATA["graph-chantier"]]></anchorNameExpression>
                </textField>
                <line>
                    <reportElement x="0" y="23" width="802" height="0" forecolor="#000000"/>
                    <graphicElement><pen lineWidth="1.0"/></graphicElement>
                </line>

                <staticText>
                    <reportElement x="0" y="34" width="802" height="16" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="13" isBold="true"/></textElement>
                    <text><![CDATA[Masse salariale par chantier (DH)]]></text>
                </staticText>
                <barChart>
                    <chart customizerClass="staport.rh.paie.report.PaieReportChartCustomizer">
                        <reportElement x="0" y="54" width="802" height="395"/>
                    </chart>
                    <categoryDataset>
                        <dataset>
                            <datasetRun subDataset="dsRepartition">
                                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{P_REPARTITION_CHANTIER})]]></dataSourceExpression>
                            </datasetRun>
                        </dataset>
                        <categorySeries>
                            <seriesExpression><![CDATA["Masse (DH)"]]></seriesExpression>
                            <categoryExpression><![CDATA[$F{libelle}]]></categoryExpression>
                            <valueExpression><![CDATA[$F{montant}]]></valueExpression>
                        </categorySeries>
                    </categoryDataset>
                    <barPlot><plot/></barPlot>
                </barChart>
            </band>
        </groupHeader>
    </group>

    <group name="GroupGraphChantierEffectif" isStartNewColumn="false" isStartNewPage="true" isReprintHeaderOnEachPage="false" keepTogether="false">
        <groupExpression><![CDATA["GRAPH_CHANTIER_EFFECTIF"]]></groupExpression>
        <groupHeader>
            <band height="455" splitType="Stretch">
                <textField>
                    <reportElement x="0" y="0" width="802" height="22" forecolor="#000000"/>
                    <textElement verticalAlignment="Bottom"><font fontName="Liberation Serif" size="16" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["II — RÉPARTITION PAR CHANTIER"]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="0" y="23" width="802" height="0" forecolor="#000000"/>
                    <graphicElement><pen lineWidth="1.0"/></graphicElement>
                </line>

                <staticText>
                    <reportElement x="0" y="34" width="802" height="16" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="13" isBold="true"/></textElement>
                    <text><![CDATA[Effectif par chantier]]></text>
                </staticText>
                <barChart>
                    <chart customizerClass="staport.rh.paie.report.PaieReportChartCustomizer">
                        <reportElement x="0" y="54" width="802" height="395"/>
                    </chart>
                    <categoryDataset>
                        <dataset>
                            <datasetRun subDataset="dsRepartition">
                                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{P_REPARTITION_CHANTIER})]]></dataSourceExpression>
                            </datasetRun>
                        </dataset>
                        <categorySeries>
                            <seriesExpression><![CDATA["Effectif"]]></seriesExpression>
                            <categoryExpression><![CDATA[$F{libelle}]]></categoryExpression>
                            <valueExpression><![CDATA[$F{effectif}]]></valueExpression>
                        </categorySeries>
                    </categoryDataset>
                    <barPlot><plot/></barPlot>
                </barChart>
            </band>
        </groupHeader>
    </group>

    <!-- Chapitre III — Répartition par fonction retiré temporairement : le référentiel Fonction
         contient des doublons non nettoyés (constaté par la direction sur ce rapport), un graphique
         par fonction serait actuellement illisible et trompeur. Section à réintroduire une fois le
         référentiel nettoyé — voir TODO.md. P_REPARTITION_FONCTION reste calculé côté Java
         (PaieBiReportBuilder/PaieReportPdfService) pour éviter de tout redévelopper à la
         réintroduction, simplement plus consommé ici tant que la donnée n'est pas fiable. -->

    <!-- Vue détaillée par chantier — approche analytique dense mais sans page supplémentaire (voir
         docs/report/README.md) : cartes KPI (même esprit que la Synthèse globale, chapitre I),
         distribution par équipe ET par fonction côte à côte, puis un stacked bar chart Équipe ×
         Fonction (composition de la masse de chaque équipe par fonction) — voir
         PaieReportCroisementChartCustomizer. -->
    <group name="GroupChantier" isStartNewColumn="false" isStartNewPage="true" isReprintHeaderOnEachPage="false" keepTogether="false">
        <groupExpression><![CDATA[$F{chantierCode}]]></groupExpression>
        <groupHeader>
            <band height="430" splitType="Stretch">
                <!-- Titre de chapitre chantier — même style que "I — Synthèse globale" / "II — ..."
                     (texte noir, sans fond), un chantier étant un chapitre du rapport au même titre
                     que les 3 premiers, jamais un bloc à identité visuelle propre. -->
                <textField>
                    <reportElement x="0" y="0" width="802" height="22" forecolor="#000000"/>
                    <textElement verticalAlignment="Bottom"><font fontName="Liberation Serif" size="16" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{chantierTitre}]]></textFieldExpression>
                    <anchorNameExpression><![CDATA["chantier-" + $F{chantierCode}]]></anchorNameExpression>
                </textField>
                <line>
                    <reportElement x="0" y="23" width="802" height="0" forecolor="#000000"/>
                    <graphicElement><pen lineWidth="1.0"/></graphicElement>
                </line>

                <!-- Cartes KPI — même style que la Synthèse globale (filet gris, label + valeur),
                     sans identité visuelle à part (voir « Style visuel »). -->
                <rectangle>
                    <reportElement x="0" y="30" width="192" height="64" mode="Transparent"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/></graphicElement>
                </rectangle>
                <staticText>
                    <reportElement x="8" y="35" width="176" height="9" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="7.5" isBold="true"/></textElement>
                    <text><![CDATA[MASSE SALARIALE]]></text>
                </staticText>
                <textField>
                    <reportElement x="8" y="45" width="176" height="34" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="11" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{chantierMasseLigne}]]></textFieldExpression>
                </textField>

                <rectangle>
                    <reportElement x="200" y="30" width="192" height="64" mode="Transparent"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/></graphicElement>
                </rectangle>
                <staticText>
                    <reportElement x="208" y="35" width="176" height="9" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="7.5" isBold="true"/></textElement>
                    <text><![CDATA[EFFECTIF]]></text>
                </staticText>
                <textField>
                    <reportElement x="208" y="45" width="176" height="20" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="14" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{chantierEffectifValeur}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="208" y="65" width="176" height="14" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="7"/></textElement>
                    <textFieldExpression><![CDATA[$F{chantierEffectifNote}]]></textFieldExpression>
                </textField>

                <rectangle>
                    <reportElement x="400" y="30" width="192" height="64" mode="Transparent"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/></graphicElement>
                </rectangle>
                <staticText>
                    <reportElement x="408" y="35" width="176" height="9" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="7.5" isBold="true"/></textElement>
                    <text><![CDATA[COÛT MOYEN / EMPLOYÉ]]></text>
                </staticText>
                <textField>
                    <reportElement x="408" y="45" width="176" height="20" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="14" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{chantierMasseMoyenneParEmploye} + " DH"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="408" y="65" width="176" height="14" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="7"/></textElement>
                    <textFieldExpression><![CDATA["Part masse globale : " + $F{chantierPartMasseGlobale}]]></textFieldExpression>
                </textField>

                <rectangle>
                    <reportElement x="600" y="30" width="192" height="64" mode="Transparent"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/></graphicElement>
                </rectangle>
                <staticText>
                    <reportElement x="608" y="35" width="176" height="9" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="7.5" isBold="true"/></textElement>
                    <text><![CDATA[STC / SORTIES]]></text>
                </staticText>
                <textField>
                    <reportElement x="608" y="45" width="176" height="20" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="14" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{chantierStc}]]></textFieldExpression>
                </textField>

                <!-- Narratif léger : phrase courte de synthèse du chantier -->
                <textField>
                    <reportElement x="0" y="100" width="802" height="14" forecolor="#595959"/>
                    <textElement><font fontName="Liberation Serif" size="10.5" isItalic="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{chantierNarratif}]]></textFieldExpression>
                </textField>

                <!-- Distribution par équipe (gauche) et par fonction (droite) — même sous-rapport
                     partagé, seul le titre/l'intitulé de colonne diffère (voir tableDistribution.jrxml). -->
                <subreport>
                    <reportElement x="0" y="118" width="390" height="100"/>
                    <subreportParameter name="P_TITRE">
                        <subreportParameterExpression><![CDATA["RÉPARTITION PAR ÉQUIPE"]]></subreportParameterExpression>
                    </subreportParameter>
                    <subreportParameter name="P_LIBELLE_COLONNE">
                        <subreportParameterExpression><![CDATA["Équipe"]]></subreportParameterExpression>
                    </subreportParameter>
                    <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource((java.util.List)$F{chantierDistributionEquipe})]]></dataSourceExpression>
                    <subreportExpression><![CDATA[$P{SUBREPORT_DISTRIBUTION}]]></subreportExpression>
                </subreport>
                <subreport>
                    <reportElement x="412" y="118" width="390" height="100"/>
                    <subreportParameter name="P_TITRE">
                        <subreportParameterExpression><![CDATA["RÉPARTITION PAR FONCTION"]]></subreportParameterExpression>
                    </subreportParameter>
                    <subreportParameter name="P_LIBELLE_COLONNE">
                        <subreportParameterExpression><![CDATA["Fonction"]]></subreportParameterExpression>
                    </subreportParameter>
                    <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource((java.util.List)$F{chantierDistributionFonction})]]></dataSourceExpression>
                    <subreportExpression><![CDATA[$P{SUBREPORT_DISTRIBUTION}]]></subreportExpression>
                </subreport>

                <!-- Distribution budgétaire croisée Équipe × Fonction — stacked bar chart, une
                     catégorie par équipe, un segment par fonction (plafonné aux 8 plus lourdes +
                     "Autres", voir PaieBiReportBuilder.croisementEquipeFonction). -->
                <staticText>
                    <reportElement x="0" y="226" width="802" height="16" forecolor="#000000"/>
                    <textElement><font fontName="Liberation Serif" size="12" isBold="true"/></textElement>
                    <text><![CDATA[Distribution budgétaire — Équipe × Fonction (DH)]]></text>
                </staticText>
                <stackedBarChart>
                    <chart customizerClass="staport.rh.paie.report.PaieReportCroisementChartCustomizer">
                        <reportElement x="0" y="244" width="802" height="172"/>
                        <chartLegend/>
                    </chart>
                    <categoryDataset>
                        <dataset>
                            <datasetRun subDataset="dsCroisement">
                                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource((java.util.List)$F{chantierCroisementEquipeFonction})]]></dataSourceExpression>
                            </datasetRun>
                        </dataset>
                        <categorySeries>
                            <seriesExpression><![CDATA[$F{fonction}]]></seriesExpression>
                            <categoryExpression><![CDATA[$F{equipe}]]></categoryExpression>
                            <valueExpression><![CDATA[$F{montant}]]></valueExpression>
                        </categorySeries>
                    </categoryDataset>
                    <barPlot><plot/></barPlot>
                </stackedBarChart>
            </band>
        </groupHeader>
    </group>

    <group name="GroupEquipe" isStartNewColumn="false" isStartNewPage="false" isReprintHeaderOnEachPage="true" keepTogether="true">
        <groupExpression><![CDATA[$F{equipeNom}]]></groupExpression>
        <groupHeader>
            <band height="56" splitType="Prevent">
                <textField>
