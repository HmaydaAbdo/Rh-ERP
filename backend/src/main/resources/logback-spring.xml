<?xml version="1.0" encoding="UTF-8"?>
<!-- Journalisation (conventions/logging.md). Le format se choisit avec logging.format : "text" (défaut) ou "json" (production).
     Chaque événement est envoyé en temps réel sur la sortie standard et archivé dans un fichier journalier. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProperty scope="context" name="LOG_FORMAT" source="logging.format" defaultValue="text"/>
    <springProperty scope="context" name="APPLICATION" source="spring.application.name" defaultValue="paie"/>
    <springProperty scope="context" name="LOG_DIR" source="logging.file.path" defaultValue="logs"/>

    <include resource="logback-${LOG_FORMAT}.xml"/>

    <root level="INFO">
        <appender-ref ref="SORTIE"/>
        <appender-ref ref="FICHIER_ASYNC"/>
    </root>
</configuration>
