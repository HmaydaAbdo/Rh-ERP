# Endpoint ERP source des chantiers (webServiceBS/getChantiers). Obligatoire :
# l'application refuse de démarrer si cette variable est absente (conventions/security.md).
CHANTIER_SYNC_BASE_URL=http://staport.dyndns.org/webServiceBS/getChantiers

# Base de données PostgreSQL — obligatoires, aucune valeur par défaut (conventions/configuration.md).
# Avec docker-compose (voir docker-compose.yml à la racine) : DB_HOST=localhost, DB_PORT=5432
# (le service "postgres" publie 5432 sur l'hôte) ; les identifiants doivent correspondre à ceux du
# fichier .env racine (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB) utilisé par ce même service.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=staport_rh
# Compte APPLICATIF (l'application, à l'exécution). En développement avec un seul compte, mettre les mêmes valeurs que
# DB_MIGRATION_* ci-dessous ; l'application signale alors au démarrage que l'intégrité de l'audit n'est pas garantie
# (normal hors production — voir conventions/deployment.md, « Deux comptes PostgreSQL »).
DB_USER=staport
DB_PASSWORD=changeme
# Compte PROPRIÉTAIRE du schéma (Flyway seulement) : le POSTGRES_USER du compose.
DB_MIGRATION_USER=staport
DB_MIGRATION_PASSWORD=changeme

# --- Authentification / RBAC (voir conventions/security.md) ---
JWT_SECRET=change-me-generate-a-real-256-bit-base64-secret
FRONTEND_URL=http://localhost:4200
COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Documentation d'API (Swagger UI sur /swagger-ui.html) ---
# Éteinte par défaut (conventions/swagger.md) : à allumer en développement seulement, jamais en production.
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# --- Journalisation SQL (développement seulement : bruyante) ---
# Décommenter pour voir les requêtes SQL dans les logs.
# SPRING_JPA_SHOW_SQL=true

# --- Email (mot de passe oublié) ---
# En développement local, sans serveur SMTP réel sous la main, lancer un attrape-mail local hors
# Compose (ex. `docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit`, UI sur :8025) et pointer
# SMTP_HOST/PORT dessus. En production, un vrai fournisseur SMTP (voir .env.example à la racine).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=noreply@staport-rh.local

# Format des journaux : text (défaut, lisible) ou json (production, asynchrone). Voir conventions/logging.md.
# LOGGING_FORMAT=json
