<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Lint Java minimal et gratuit : ne retient que des défauts objectifs (imports, blocs vides, comparaisons de chaînes).
     À durcir règle par règle, en gardant le code existant vert. Lancé par `./mvnw checkstyle:check` et par la CI. -->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <module name="TreeWalker">
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="AvoidStarImport">
      <property name="allowStaticMemberImports" value="true"/>
    </module>
    <module name="EmptyStatement"/>
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="^(ignore|ignored|expected)$"/>
    </module>
    <module name="StringLiteralEquality"/>
    <module name="MissingSwitchDefault"/>
    <module name="ModifierOrder"/>
  </module>
</module>
